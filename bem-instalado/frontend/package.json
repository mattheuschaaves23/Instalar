{
  "name": "bem-instalado-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "axios": "^1.18.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.4.1",
    "react-router": "8.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.4.2",
    "@vitejs/plugin-legacy": "8.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "terser": "^5.46.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "postcss-selector-parser": "^6.1.4"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:android:web": "vite build --mode android",
    "build:ios:web": "vite build --mode ios",
    "android:sync": "vite build --mode android && cap sync android",
    "android:apk:debug": "vite build --mode android && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:aab:release": "vite build --mode android && cap sync android && cd android && gradlew.bat bundleRelease",
    "ios:sync": "vite build --mode ios && cap sync ios",
    "test": "vitest run"
  }
}
