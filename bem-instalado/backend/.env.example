PORT=5000
APP_NAME=InstalaPro
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bem_instalado
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bem_instalado
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_SSL=false
JWT_SECRET=use_uma_chave_longa_e_unica_com_pelo_menos_32_caracteres
# Chave aleatória de 32 bytes (base64 ou hex) para criptografar o segredo do 2FA.
# Nunca a altere depois que usuários ativarem 2FA sem migrar os segredos existentes.
TWO_FACTOR_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:5000
# DSN privado do projeto backend no Sentry. Não usar no frontend.
SENTRY_DSN=
# Cloudflare Turnstile: valide sempre no backend; nunca exponha a chave secreta.
TURNSTILE_SECRET_KEY=
# URL secreta de heartbeat do Better Stack. É chamada somente após a rotina operacional concluir.
BETTERSTACK_HEARTBEAT_URL=
MARKETPLACE_URL=https://www.beminstalado.com.br
MARKETPLACE_CTA_LABEL=Visitar loja oficial
MARKETPLACE_WHATSAPP_URL=https://api.whatsapp.com/send?phone=5548999816000
MARKETPLACE_CONTACT_PHONE=(48) 99981-6000
MARKETPLACE_CONTACT_EMAIL=beminstaladohd@gmail.com
NOMINATIM_EMAIL=contato@beminstalado.com
GEOCODING_CONTACT=contato@beminstalado.com
# Opcional: endpoint /reverse de uma instância Photon própria ou contratada.
# Sem configuração, usa photon.komoot.io com cache e limite de buscas públicas.
GEOCODING_REVERSE_URL=
PIX_KEY=pagamentos@beminstalado.com
PIX_STATIC_CODE=
PIX_DISPLAY_KEY=
PIX_RECIPIENT_NAME=Bem Instalado
PIX_CITY=Sao Paulo
PIX_DESCRIPTION=Assinatura Bem Instalado
SUBSCRIPTION_PRICE=49.90
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_LAUNCH_ACCESS=false
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=false
ALLOW_MANUAL_SUBSCRIPTION_CONFIRMATION=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=InstalaPro/1.0 (Node.js; sandbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=beminstaladohd@gmail.com
SMTP_PASSWORD=
SMTP_FROM=InstalaPro <beminstaladohd@gmail.com>
# Endpoint de alertas (Discord, Slack ou Better Uptime) e token exclusivo da rotina de operaÃ§Ã£o.
# Nunca exponha OPERATIONS_TOKEN no front-end ou em monitor pÃºblico.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_AUTHORIZATION=
OPERATIONS_TOKEN=
OUTBOUND_DELIVERY_MAX_ATTEMPTS=5
OUTBOUND_DELIVERY_BATCH_SIZE=20
# JSON de uma conta de serviço do Firebase, em uma única linha. Deixe vazio para desativar push remoto.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
